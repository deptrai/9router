{
  "name": "9router-ecommerce-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:seed": "pnpm --filter=@repo/database seed",
    "legacy:dev": "pnpm --filter=@repo/legacy dev",
    "legacy:build": "pnpm --filter=@repo/legacy build"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  }
}
