# ============================================================================
# 9Router E-Commerce Platform — Production Environment Variables
# Duplicate this file to .env.prod and configure all required secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_strong_random_password_here
POSTGRES_DB=9router_ecommerce
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Ports Exposure
# ----------------------------------------------------------------------------
API_PORT=3201
ADMIN_PORT=3200
MINI_APP_PORT=3000

# ----------------------------------------------------------------------------
# Security & Administrative Credentials (MANDATORY)
# ----------------------------------------------------------------------------
# Admin API key must be at least 32 characters long
ADMIN_API_KEY=super-secret-admin-key-that-is-at-least-32-chars-long!

# 32-byte (64 hex characters) key for AES-256-GCM encryption of sensitive credentials in DB
# Generate with: openssl rand -hex 32
STORE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------------------------------
# Telegram Bot Configuration
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_SECRET=your_telegram_bot_webhook_secret

# ----------------------------------------------------------------------------
# Client-Facing API URL (consumed by Next.js Admin & Mini App)
# In production, replace with your reverse proxy domain (e.g. https://api.9router.com)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3201

# ----------------------------------------------------------------------------
# Payment Gateways (Optional / Production enabled)
# ----------------------------------------------------------------------------
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

BITCART_API_URL=https://bitcart.yourdomain.com
BITCART_API_KEY=
BITCART_MERCHANT_ID=

# ----------------------------------------------------------------------------
# Sourcing & Worker Parameters
# ----------------------------------------------------------------------------
SOURCING_PURCHASE_TIMEOUT_MS=45000
