# ============================================================================
# Multi-stage Dockerfile for 9Router Telegram Mini App (Next.js Standalone)
# ============================================================================

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# ----------------------------------------------------------------------------
# Builder stage
# ----------------------------------------------------------------------------
FROM base AS builder

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/mini-app/package.json ./apps/mini-app/

RUN pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY packages/shared-types/ ./packages/shared-types/
COPY apps/mini-app/ ./apps/mini-app/

# Build shared types first, then standalone Next.js mini-app
RUN pnpm --filter @repo/shared-types build
RUN pnpm --filter @repo/mini-app build

# ----------------------------------------------------------------------------
# Runner stage: minimal standalone Next.js runner
# ----------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy standalone output from Next.js build
COPY --from=builder /app/apps/mini-app/.next/standalone ./
COPY --from=builder /app/apps/mini-app/.next/static ./apps/mini-app/.next/static
COPY --from=builder /app/apps/mini-app/public ./apps/mini-app/public

EXPOSE 3000
CMD ["node", "apps/mini-app/server.js"]
