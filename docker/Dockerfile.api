# ============================================================================
# Multi-stage Dockerfile for 9Router API & Scraper Worker
# ============================================================================

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# ----------------------------------------------------------------------------
# Builder stage: install all deps, build packages and api
# ----------------------------------------------------------------------------
FROM base AS builder

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/

RUN pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY packages/database/ ./packages/database/
COPY packages/shared-types/ ./packages/shared-types/
COPY apps/api/ ./apps/api/

RUN pnpm --filter @repo/shared-types build
RUN pnpm --filter @repo/database build
RUN pnpm --filter @repo/api build

# ----------------------------------------------------------------------------
# Runner stage: lightweight production image
# ----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy lockfile and package manifests for production install
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/

RUN pnpm install --frozen-lockfile --prod

# Copy compiled artifacts from builder
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/database/drizzle ./packages/database/drizzle
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Default: runs API server. Overridden by worker service in docker-compose.prod.yml.
EXPOSE 3201
CMD ["node", "apps/api/dist/main.js"]
